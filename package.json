{
  "name": "volleyball-stats-backend",
  "version": "1.0.0",
  "description": "Volleyball statistics REST API",
  "main": "app.js",
  "scripts": {
    "test": "jest --forceExit --detectOpenHandles",
    "test:ci": "jest --forceExit --detectOpenHandles --ci",
    "dev": "set NODE_ENV=development&& node app.js",
    "prod": "set NODE_ENV=production&& node app.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 15000,
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "controllers/**/*.js",
      "middleware/**/*.js",
      "!**/node_modules/**"
    ]
  },
  "keywords": [
    "node.js",
    "express",
    "jwt",
    "volleyball",
    "statistics",
    "rest api",
    "authentication",
    "authorization",
    "mysql"
  ],
  "author": "dnxtpro",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cookie-session": "^2.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "express-rate-limit": "^8.5.2",
    "googleapis": "^144.0.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "sequelize": "^6.37.3",
    "sequelize-cli": "^6.6.2",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  }
}
